    given-names: Rinat
version: 1.0.2
license: MIT
repository-code: "https://github.com/rinatrizvanov/prsguard-demo"
url: "https://rinatrizvanov.github.io/prsguard-demo/"
keywords:
  - polygenic score
  - PGS Catalog
  - applicability
  - ClawBio
